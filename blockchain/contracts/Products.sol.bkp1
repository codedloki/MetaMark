// SPDX-License-Identifier: MIT
pragma solidity ^0.8.19;

import "@openzeppelin/contracts/utils/cryptography/MerkleProof.sol";

interface IRegistry {
    function isManufacturer(address _user) external view returns (bool);
}

contract Products {
    using MerkleProof for bytes32[];

    // ===================== STRUCTS =====================
    struct Product {
        string details;            // IPFS hash
        address manufacturer;
        bool isActive;
    }

    struct Batch {
        bytes32 productId;
        uint256 batchId;
        string ipfsHash;           // IPFS containing merkle proofs mapping
        bytes32 merkleRoot;
        bool exists;
    }

    // ===================== STORAGE =====================
    mapping(bytes32 => Product) public products;
    mapping(bytes32 => mapping(uint256 => Batch)) public batches;
    mapping(bytes32 => uint256[]) private productBatchIds;

    // keccak(leaf) => used
    mapping(bytes32 => bool) public serialIdUsed;

    mapping(address => bytes32[]) private manufacturerProducts;
    mapping(bytes32 => bool) private ipfsHashUsed;

    IRegistry public registry;

    // ===================== EVENTS =====================
    event ProductRegistered(bytes32 indexed productId, string details, address manufacturer);
    event BatchAdded(bytes32 indexed productId, uint256 indexed batchId, string ipfsHash, bytes32 merkleRoot);
    event BatchIPFSUpdated(bytes32 indexed productId, uint256 indexed batchId, string newIpfsHash);
    event BatchMerkleRootUpdated(bytes32 indexed productId, uint256 indexed batchId, bytes32 newMerkleRoot);
    event SerialVerified(bytes32 indexed productId, uint256 indexed batchId, bytes32 leafHash, address verifier);

    // ===================== CONSTRUCTOR =====================
    constructor(address _registryAddress) {
        registry = IRegistry(_registryAddress);
    }

    // ===================== MODIFIERS =====================
    modifier onlyManufacturer() {
        require(registry.isManufacturer(msg.sender), "Not a registered manufacturer");
        _;
    }

    modifier productExists(bytes32 _productId) {
        require(products[_productId].manufacturer != address(0), "Product does not exist");
        _;
    }

    modifier batchExists(bytes32 _productId, uint256 _batchId) {
        require(batches[_productId][_batchId].exists, "Batch does not exist");
        _;
    }

    // ===================== PRODUCT =====================
    function registerProduct(
        string memory _details,
        uint256 _nonce
    ) external onlyManufacturer returns (bytes32) {
        bytes32 detailsHash = keccak256(bytes(_details));
        require(!ipfsHashUsed[detailsHash], "IPFS already used");

        bytes32 productId = keccak256(
            abi.encodePacked(msg.sender, _details, _nonce, block.timestamp)
        );

        require(products[productId].manufacturer == address(0), "Product exists");

        products[productId] = Product({
            details: _details,
            manufacturer: msg.sender,
            isActive: true
        });

        ipfsHashUsed[detailsHash] = true;
        manufacturerProducts[msg.sender].push(productId);

        emit ProductRegistered(productId, _details, msg.sender);
        return productId;
    }

    function toggleProductStatus(bytes32 _productId)
        external
        onlyManufacturer
        productExists(_productId)
    {
        require(products[_productId].manufacturer == msg.sender, "Not owner");
        products[_productId].isActive = !products[_productId].isActive;
    }

    // ===================== BATCH =====================
    function addBatch(
        bytes32 _productId,
        uint256 _batchId,
        string memory _ipfsHash,
        bytes32 _merkleRoot
    )
        external
        onlyManufacturer
        productExists(_productId)
    {
        require(products[_productId].manufacturer == msg.sender, "Not owner");
        require(products[_productId].isActive, "Product inactive");
        require(!batches[_productId][_batchId].exists, "Batch exists");
        require(_merkleRoot != bytes32(0), "Invalid root");

        batches[_productId][_batchId] = Batch({
            productId: _productId,
            batchId: _batchId,
            ipfsHash: _ipfsHash,
            merkleRoot: _merkleRoot,
            exists: true
        });

        productBatchIds[_productId].push(_batchId);

        emit BatchAdded(_productId, _batchId, _ipfsHash, _merkleRoot);
    }

    function updateBatchIPFSHash(
        bytes32 _productId,
        uint256 _batchId,
        string memory _newIPFSHash
    )
        external
        onlyManufacturer
        batchExists(_productId, _batchId)
    {
        require(products[_productId].manufacturer == msg.sender, "Not owner");
        batches[_productId][_batchId].ipfsHash = _newIPFSHash;

        emit BatchIPFSUpdated(_productId, _batchId, _newIPFSHash);
    }

    function getProduct(bytes32 _productId)
    external
    view
    returns (
        string memory details,
        address manufacturer,
        bool isActive
    )
{
    Product storage p = products[_productId];
    require(p.manufacturer != address(0), "Product does not exist");

    return (p.details, p.manufacturer, p.isActive);
}

    function updateBatchMerkleRoot(
        bytes32 _productId,
        uint256 _batchId,
        bytes32 _newMerkleRoot
    )
        external
        onlyManufacturer
        batchExists(_productId, _batchId)
    {
        require(products[_productId].manufacturer == msg.sender, "Not owner");
        require(_newMerkleRoot != bytes32(0), "Invalid root");

        batches[_productId][_batchId].merkleRoot = _newMerkleRoot;

        emit BatchMerkleRootUpdated(_productId, _batchId, _newMerkleRoot);
    }

    // ===================== ✅ SERIAL VERIFICATION =====================
    function verifySerial(
        bytes32 _productId,
        uint256 _batchId,
        bytes32 _leaf,
        bytes32[] calldata _merkleProof
    )
        external
        productExists(_productId)
        batchExists(_productId, _batchId)
    {
        Batch storage batch = batches[_productId][_batchId];

        // barcode contains keccak(leaf)
        bytes32 leafHash = keccak256(abi.encodePacked(_leaf));
        require(!serialIdUsed[leafHash], "Already verified");

        require(
            MerkleProof.verify(_merkleProof, batch.merkleRoot, _leaf),
            "Invalid Merkle proof"
        );

        serialIdUsed[leafHash] = true;
        emit SerialVerified(_productId, _batchId, leafHash, msg.sender);
    }

    // ===================== GETTERS (CRITICAL) =====================
    function getProductsByManufacturer(address _manufacturer)
        external
        view
        returns (bytes32[] memory)
    {
        return manufacturerProducts[_manufacturer];
    }

    function getProductBatchIds(bytes32 _productId)
        external
        view
        returns (uint256[] memory)
    {
        return productBatchIds[_productId];
    }

    function getBatch(bytes32 _productId, uint256 _batchId)
        external
        view
        returns (Batch memory)
    {
        require(batches[_productId][_batchId].exists, "Batch not found");
        return batches[_productId][_batchId];
    }

    function isLeafUsed(bytes32 leafHash)
        external
        view
        returns (bool)
    {
        return serialIdUsed[leafHash];
    }

    function getManufacturerByProduct(bytes32 _productId)
        external
        view
        returns (address)
    {
        return products[_productId].manufacturer;
    }
}
